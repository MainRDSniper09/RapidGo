diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..465a642
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,10 @@
+# Copiar como .env y ajustar si es necesario (el .env NO se sube a GitHub)
+
+# Desde Windows/host: localhost:9092
+# Desde un contenedor dentro de rapidgo-net: kafka:19092
+KAFKA_BOOTSTRAP_SERVERS=localhost:9092
+KAFKA_TOPIC=preparacion_pedidos
+KAFKA_PARTICIONES=3
+KAFKA_REPLICACION=1
+
+EQUIPO_ID=rapidgo-v6
diff --git a/README.md b/README.md
index ac44a54..4d19802 100644
--- a/README.md
+++ b/README.md
@@ -61,4 +61,25 @@ SPARK STRUCTURED STREAMING
     calidad -> agregación -> reporte
             |
             v
-     INDICADORES / ALERTAS
\ No newline at end of file
+     INDICADORES / ALERTAS
+```
+
+---
+
+## Ejecución rápida (Semana 2)
+
+```powershell
+docker compose up -d                       # Kafka + creación del topic + Spark
+python -m venv .venv
+.\.venv\Scripts\Activate.ps1
+pip install -r requirements.txt
+python -m producer --eventos 100 --intervalo 0.2
+pytest -v
+```
+
+| Componente | Documentación |
+|------------|---------------|
+| Producer / Kafka | [`producer/README.md`](producer/README.md) |
+| Contrato del evento | [`samples/contrato_evento_variante6.schema.json`](samples/contrato_evento_variante6.schema.json) |
+| Decisión topic / key / particiones | [`docs/decisions/ADR-001-kafka.md`](docs/decisions/ADR-001-kafka.md) |
+
diff --git a/docker-compose.yml b/docker-compose.yml
index 2beb4ed..0c67385 100644
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -59,6 +59,36 @@ services:
       retries: 10
 
 
+  # ==========================================================
+  # KAFKA INIT - Crea el topic definido en ADR-001
+  # (auto-create está desactivado, por eso se crea explícitamente)
+  # Se ejecuta una vez y termina.
+  # ==========================================================
+  kafka-init:
+    image: apache/kafka:4.3.1
+    container_name: rapidgo-kafka-init
+
+    depends_on:
+      kafka:
+        condition: service_healthy
+
+    entrypoint: ["/bin/sh", "-c"]
+    command:
+      - |
+        /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:19092 \
+          --create --if-not-exists \
+          --topic preparacion_pedidos \
+          --partitions 3 \
+          --replication-factor 1
+        /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:19092 \
+          --describe --topic preparacion_pedidos
+
+    networks:
+      - rapidgo-net
+
+    restart: "no"
+
+
   # ==========================================================
   # SPARK MASTER
   # ==========================================================
@@ -68,8 +98,8 @@ services:
     hostname: spark-master
 
     depends_on:
-      kafka:
-        condition: service_healthy
+      kafka-init:
+        condition: service_completed_successfully
 
