# Copiar como .env y ajustar si es necesario (el .env NO se sube a GitHub)

# Desde Windows/host: localhost:9092
# Desde un contenedor dentro de rapidgo-net: kafka:19092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=preparacion_pedidos
KAFKA_PARTICIONES=3
KAFKA_REPLICACION=1

EQUIPO_ID=rapidgo-v6
